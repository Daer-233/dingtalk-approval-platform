# 复制为 .env 后填写。Client Secret 只保存在这台电脑，不要提交或发送到聊天。
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_AGENT_ID=
DINGTALK_CORP_ID=
DINGTALK_ORIGINATOR_USER_ID=
DINGTALK_ORIGINATOR_DEPT_ID=
# 表单“申请人部门”的部门 ID；留空时沿用固定发起人 DeptId。
DINGTALK_APPLICANT_DEPT_ID=
DINGTALK_PROCESS_CODE=

# 仅用于兼容旧任务。新任务会从钉钉流程预测结果动态读取 actionerKey。
DINGTALK_ACTIONER_KEYS_JSON={"director":"","manager":"","department_head":""}

# 附件权限和测试审批模板联调通过后，再把以下两项改为 true。
DINGTALK_ATTACHMENT_ENABLED=false
DINGTALK_LIVE_SUBMIT_ENABLED=false

# 每批审批的最大并发数，取值 1-5；默认 3。
DINGTALK_BATCH_CONCURRENCY=3
